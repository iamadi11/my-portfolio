{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "portfolio-v2",
            "runtimeExecutable": "bash",
            "runtimeArgs": [
                "-c",
                "source ~/.nvm/nvm.sh && npm run dev"
            ],
            "port": 3000,
            "autoPort": true
        },
        {
            "name": "portfolio-sample-avatar",
            "runtimeExecutable": "bash",
            "runtimeArgs": [
                "-c",
                "source ~/.nvm/nvm.sh && HOST_SAMPLE_AVATAR=1 npm run dev"
            ],
            "port": 3000,
            "autoPort": true
        }
    ]
}
