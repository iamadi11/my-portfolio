# Uploaded by `vercel deploy`: only what the app needs to build.
# Research, design sources and local tooling stay on this machine (and secrets never leave it).
.env*
# docs stays local except the course's learning graph, which /learn reads at build time.
docs/*
!docs/system-design/
docs/system-design/*
!docs/system-design/CURRICULUM.md
assets-src
graphify-out
.obsidian
.cursor
# Local tooling stays off the build. The course figures import the anatomy kit, so that one file is uploaded.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/anatomy/
.claude/skills/anatomy/*
!.claude/skills/anatomy/kit/
.claude/skills/anatomy/kit/*
!.claude/skills/anatomy/kit/iso-kit.ts
.agents
*.pdf
